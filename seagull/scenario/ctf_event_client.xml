<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  CTF (Charging Trigger Function) Client Scenario - Event-Based Charging (ECUR)
  Flow:
    1. Capabilities Exchange (CER -> CEA)
    2. ACR [Event] (Record-Type = 4, Record-Number = 0) -> ACA (2001)
    Simulates one-off charging events such as SMS delivery or emergency service.
-->
<scenario>
  <counter>
    <counter name="event_session_cnt" start="50000" step="1" datatype="4"></counter>
  </counter>

  <!-- Initialization: Capabilities Exchange -->
  <init>
    <send channel="channel-1">
      <command name="CER">
        <avp name="Origin-Host" value="ctf.rf.telecom.org"></avp>
        <avp name="Origin-Realm" value="rf.telecom.org"></avp>
        <avp name="Host-IP-Address" value="0x00017f000001"></avp>
        <avp name="Vendor-Id" value="10415"></avp>
        <avp name="Product-Name" value="Seagull-CTF-Client"></avp>
        <avp name="Acct-Application-Id" value="3"></avp>
      </command>
    </send>
    <receive channel="channel-1">
      <command name="CEA">
        <avp name="Result-Code" value="2001"></avp>
      </command>
    </receive>
  </init>

  <!-- Traffic: Event-Based Accounting Request -->
  <traffic>
    <send channel="channel-1">
      <action>
        <increment-counter name="event_session_cnt"></increment-counter>
        <set-value name="Session-Id" format="ctf.rf.telecom.org;event;$(event_session_cnt)"></set-value>
      </action>
      <command name="ACR">
        <avp name="Session-Id" value="value_is_replaced"></avp>
        <avp name="Origin-Host" value="ctf.rf.telecom.org"></avp>
        <avp name="Origin-Realm" value="rf.telecom.org"></avp>
        <avp name="Destination-Realm" value="rf.telecom.org"></avp>
        <avp name="Acct-Application-Id" value="3"></avp>
        <avp name="Accounting-Record-Type" value="4"></avp> <!-- 4 = EVENT_RECORD -->
        <avp name="Accounting-Record-Number" value="0"></avp>
        <avp name="Service-Context-Id" value="32260@3gpp.org"></avp>
        <avp name="User-Name" value="491709876543@rf.telecom.org"></avp>
        <avp name="Calling-Party-Address" value="tel:+491709876543"></avp>
        <avp name="Called-Party-Address" value="tel:+491701112233"></avp>
      </command>
    </send>

    <receive channel="channel-1">
      <command name="ACA">
        <avp name="Result-Code" value="2001"></avp>
        <avp name="Accounting-Record-Type" value="4"></avp>
        <avp name="Accounting-Record-Number" value="0"></avp>
      </command>
    </receive>
  </traffic>
</scenario>
