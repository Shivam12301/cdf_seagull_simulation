<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  Seagull Configuration for CDF (Charging Data Function) Server
  Acts as Diameter Server listening on TCP port 3868
-->
<configuration name="CDF Diameter Server">
  <!-- Protocol Transport Definition -->
  <define entity="transport"
    name="trans-ip-v4"
    file="libtrans_ip.so"
    type="tcp">
  </define>

  <!-- Transport Channel: CDF Server listening on 0.0.0.0:3868 -->
  <define entity="channel"
    name="channel-1"
    transport="trans-ip-v4">
    <parameter name="transport-mode" value="server"></parameter>
    <parameter name="transport-ip" value="0.0.0.0"></parameter>
    <parameter name="transport-port" value="3868"></parameter>
  </define>

  <!-- Traffic Configuration -->
  <define entity="traffic-param" name="call-rate" value="10"></define>
  <define entity="traffic-param" name="display-period" value="1"></define>
  <define entity="traffic-param" name="log-stat-period" value="5"></define>
  <define entity="traffic-param" name="log-stat-file" value="../logs/cdf_server_stat.csv"></define>

</configuration>
